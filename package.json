{
  "name": "scoutech",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "vitest bench --reporter=verbose",
    "build": "vite build",
    "build:pages": "vite build && cp dist/client/index.html dist/client/404.html",
    "dev": "vite dev --port 3000",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint-type-aware": "oxlint --type-aware --type-check",
    "lint:github": "oxlint --type-aware --type-check --format=github",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ci": "vitest run --exclude src/lib/sim/bench-harness.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/iosevka-charon": "^5.3.0",
    "@fontsource/iosevka-charon-mono": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/router-plugin": "1.168.48",
    "cesium": "1.147.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "d3-shape": "3.2.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.65.0",
    "maplibre-gl": "6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.6",
    "@types/d3-shape": "3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.4"
}
